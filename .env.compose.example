# Copy this file to .env beside compose.yaml, then replace all secret values.
# Use URL-safe characters for POSTGRES_PASSWORD because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
SECRET_KEY=replace-with-a-long-random-jwt-secret
SESSION_SECRET=replace-with-a-long-random-session-secret

# Local development and competition demo only. Set false for public deployment.
DEMO_LOGIN_ENABLED=true
FRONTEND_ORIGIN=http://localhost:3000
API_URL=http://localhost:8000
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Optional real integrations. Google and email login require their own credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
GEMINI_API_KEY=

# Set when the backend checkout is not ../backend-project/backend.
# BACKEND_BUILD_CONTEXT=../backend-project/backend
