# Frontend build-time config. Copy to .env (beside docker-compose.yml) on the
# server, or to .env.local for `npm run dev`. All values are baked into the
# static build — change here and redeploy (docker compose up -d --build) to apply.

# Backend API base URL. Change this one line if the backend moves or its URL changes.
NEXT_PUBLIC_API_BASE_URL=https://api.scholarmap.uz

# Local-only UI fixtures (no backend needed). Keep false for real deploys.
NEXT_PUBLIC_ENABLE_DEMO_FIXTURES=false

# Show the backend /auth/demo-login button. Enable only if that endpoint is on.
NEXT_PUBLIC_ENABLE_BACKEND_DEMO_LOGIN=false

# On-display translation needs a server route that the static build omits.
# Leave false for the static deploy; content shows in its original language.
NEXT_PUBLIC_ENABLE_TRANSLATION=false
