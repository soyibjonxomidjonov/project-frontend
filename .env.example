NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Set to true to view clearly labelled, local-only UI fixtures.
NEXT_PUBLIC_ENABLE_DEMO_FIXTURES=false
# Set true only when the FastAPI /auth/demo-login endpoint is intentionally enabled.
NEXT_PUBLIC_ENABLE_BACKEND_DEMO_LOGIN=false

# Server-side translation of existing backend content. Use an OpenAI-compatible endpoint.
# These values are private; never prefix them with NEXT_PUBLIC_.
TRANSLATION_BASE_URL=https://api.groq.com/openai/v1
TRANSLATION_MODEL=llama-3.3-70b-versatile
TRANSLATION_API_KEY=
# Used by the translation route when NEXT_PUBLIC_API_BASE_URL is a browser-only path.
API_INTERNAL_URL=http://localhost:8000
